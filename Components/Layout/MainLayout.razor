@inherits LayoutComponentBase
@inject NavigationManager NavigationManager


<div class="page">
    <RadzenComponents @rendermode="InteractiveAuto" />
@*     <div class="sidebar">
        <NavMenu />
    </div> *@

    <main>
        <div class="top-row px-4">
            @* <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>*@
            <RadzenButton Click="@(args=>OnClick("/"))" Icon="west" ButtonStyle="ButtonStyle.Base" />
            <RadzenButton Click="@(args=>OnClick("settingpage"))" Icon="settings" ButtonStyle="ButtonStyle.Primary" />
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
@{
    async Task OnClick(string button)
    {
        
        NavigationManager.NavigateTo(button);
    }
}